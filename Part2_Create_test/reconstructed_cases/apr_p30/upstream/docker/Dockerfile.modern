# Qiskit sandbox for the APR agent (py3.11). Based on ../../hpc/docker/Dockerfile.modern,
# but without the ENTRYPOINT (mini-swe-agent starts the container with `sleep`)
# and with only the versions the task set needs by default.
FROM python:3.11-slim

ARG QISKIT_VERSIONS="0.46.3 1.2.4 2.5.0"

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MPLBACKEND=Agg

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    mkdir -p /opt/venvs /opt/build-logs; \
    for v in ${QISKIT_VERSIONS}; do \
        venv="/opt/venvs/qiskit-$v"; \
        python -m venv "$venv"; \
        "$venv/bin/pip" install -q --upgrade pip setuptools wheel; \
        if ! "$venv/bin/pip" install -q "qiskit==$v" > "/opt/build-logs/$v.log" 2>&1; then \
            echo "CORE INSTALL FAILED: $v" >> /opt/build-logs/FAILED.txt; \
            rm -rf "$venv"; continue; \
        fi; \
        "$venv/bin/pip" install -q qiskit-aer          >> "/opt/build-logs/$v.log" 2>&1 || echo "aer failed: $v"      >> /opt/build-logs/PARTIAL.txt; \
        "$venv/bin/pip" install -q qiskit-ibm-runtime  >> "/opt/build-logs/$v.log" 2>&1 || echo "runtime failed: $v"  >> /opt/build-logs/PARTIAL.txt; \
        "$venv/bin/pip" install -q matplotlib pylatexenc >> "/opt/build-logs/$v.log" 2>&1 || true; \
        "$venv/bin/python" -c "import qiskit; print('$v ->', qiskit.__version__)"; \
    done; \
    ls /opt/venvs

WORKDIR /work
