flowchart TD
    INPUT["30 frozen cases<br/>Buggy code + sanitized question + pinned Qiskit"]
    DRIVER["Orchestrator: Python experiment driver<br/>Prepare tasks, check environment, schedule workers"]
    INPUT --> DRIVER

    subgraph LOOP["Per-case repair loop"]
        AGENT["DefaultAgent<br/>Prompt, conversation, limits, termination"]
        ADAPTER["Model adapter<br/>Native request / response conversion"]
        BROKER["Separate API broker<br/>Credentials + file queue + API traffic"]
        MODEL["GPT or Claude<br/>Analyze the issue and choose a Bash action"]
        HARNESS["Execution harness<br/>Monitored Bash + pinned Python"]
        WORK["Case workspace: buggy.py<br/>Inspect, edit, and run"]
        AGENT <-->|"Conversation / model response"| ADAPTER
        ADAPTER <-->|"Request / response files"| BROKER
        BROKER <-->|"Provider API"| MODEL
        AGENT -->|"Bash action"| HARNESS
        HARNESS --> WORK
        WORK -->|"Script output, errors, exit code"| AGENT
    end

    DRIVER -->|"Fresh agent for each model and case"| AGENT
    AGENT -->|"Submit, limit, or API error"| SNAPSHOT["Freeze candidate and trajectory<br/>patched.py + traj.json + agent_result.json"]
    SNAPSHOT --> GATE["All repair tasks closed<br/>GPT run: durable 90-task generation barrier"]
    GATE --> VALIDATOR["Final validator<br/>Run unchanged existing tests"]
    HELDOUT["Evaluation-only inputs<br/>Original buggy code + reference fixed.py + test.py"] --> VALIDATOR
    VALIDATOR --> RESULTS["Per-case results + comparison CSV + audit"]

    classDef agent fill:#dbeafe,stroke:#2563eb,color:#172554;
    classDef model fill:#ede9fe,stroke:#7c3aed,color:#2e1065;
    classDef harness fill:#dcfce7,stroke:#16a34a,color:#14532d;
    classDef evaluation fill:#ffedd5,stroke:#ea580c,color:#7c2d12;
    class AGENT agent;
    class ADAPTER,BROKER,MODEL model;
    class HARNESS,WORK harness;
    class GATE,VALIDATOR,HELDOUT,RESULTS evaluation;
